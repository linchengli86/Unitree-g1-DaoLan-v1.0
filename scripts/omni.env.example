# Copy to run/config/omni.env on PC2, chmod 600, then restart mobile guide.
# Never put a real API key in the repository or the web page.
DASHSCOPE_API_KEY=
OMNI_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
OMNI_MODEL=qwen3.5-omni-flash-realtime
# For newer workspace-bound models, set your workspace WebSocket URL above.
# Route execution requires both switches and an operator PIN.
GUIDE_MOTION_ENABLED=0
GUIDE_OPERATOR_PIN=
# New quickstart installs use motion-only mode; enable separately for TTS.
GUIDE_AUDIO_ENABLED=0
# Separate point-navigation module gate; enable only after supervised acceptance.
GUIDE_NAMED_NAV_VERIFIED=0
# Enable only after a supervised physical test of each official preset.
GUIDE_ARM_ENABLED=0
GUIDE_VERIFIED_ARM_ACTIONS=
